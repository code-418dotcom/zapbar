{
  "name": "@zapbar/remote",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@expo-google-fonts/comic-neue": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.1",
    "@zapbar/heos-core": "workspace:*",
    "expo": "~58.0.14",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.8",
    "expo-iap": "^6.1.0",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-tcp-socket": "^6.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.3.0",
    "jest": "~29.7.0",
    "jest-expo": "~58.0.11",
    "playwright-core": "1.64.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "apk": "expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease",
    "brand": "node scripts/brand-assets.mjs",
    "quick-res": "node scripts/quick-res.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|react-native-tcp-socket|fast-xml-parser|strnum|zustand)"
    ],
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/fakes/",
      "/__tests__/fixtures/"
    ]
  }
}
